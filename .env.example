# Local Postgres credentials. Used by docker-compose.yml and the migration
# tooling in `packages/db`. Copy to `.env` (gitignored) before running
# `pnpm db:up` for the first time.
#
# IMPORTANT: POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD must agree with
# the values embedded in DATABASE_URL. Compose seeds the database from the
# POSTGRES_* triple on first boot; drizzle-kit and the migration runner read
# DATABASE_URL. If they drift, `pnpm db:up` will succeed and `pnpm db:migrate`
# will fail with an opaque auth error.

POSTGRES_DB=maritime
POSTGRES_USER=maritime
POSTGRES_PASSWORD=maritime

# Optional: override the host port if 5432 is already in use on your machine
# (e.g. a system Postgres). Container always listens on 5432 internally.
# POSTGRES_HOST_PORT=5433

# Connection string consumed by drizzle-kit and the @maritime/db migration
# script. The port here must match POSTGRES_HOST_PORT above (or 5432 if you
# leave POSTGRES_HOST_PORT unset).
DATABASE_URL=postgres://maritime:maritime@localhost:5432/maritime
