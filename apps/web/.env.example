# Web app environment — copy to .env.local (gitignored) and fill in real values.
# .env.local is loaded automatically by Next.js for local development.

# Mapbox public token (pk.…). Used by the dark satellite basemap.
# Get one from https://account.mapbox.com after signing up. Domain-lock the
# token before any public deploy.
NEXT_PUBLIC_MAPBOX_TOKEN=

# WebSocket URL of the local worker service. Browser connects here for the
# live AIS stream. The worker service ships in M2 (issue #4).
NEXT_PUBLIC_WORKER_WS_URL=ws://localhost:8787
