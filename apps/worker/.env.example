# Port the worker's WebSocket server listens on. Browsers connect here.
# Must match NEXT_PUBLIC_WORKER_WS_URL in apps/web/.env.local.
WORKER_WS_PORT=8787

# Upstream vessel source. "aisstream" connects to AISStream.io's free
# WebSocket firehose; "synthetic" runs the M2 in-memory simulator.
# Defaults to "aisstream" when unset.
VESSEL_SOURCE=aisstream

# AISStream API key — required when VESSEL_SOURCE=aisstream. Sign in via
# GitHub OAuth on https://aisstream.io to mint one. Without a key the
# worker will refuse to start the aisstream source; switch to synthetic
# to run offline.
AISSTREAM_KEY=
